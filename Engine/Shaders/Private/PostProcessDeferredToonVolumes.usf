#include "Common.ush"
#include "DeferredShadingCommon.ush"
#include "PostProcessCommon.ush"
#include "ScreenPass.ush"

// [DeferredToon] Linear HDR mapping from scene inputs inside each authored box.
SCREEN_PASS_TEXTURE_VIEWPORT(Input)

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
Texture2D ShadowBufferTexture;
SamplerState ShadowBufferSampler;
// [DeferredToon] Separate direct-specular input; DirectLight remains diffuse-only.
Texture2D SpecularBufferTexture;
SamplerState SpecularBufferSampler;
Texture3D ShadowColorVolume;
SamplerState ShadowColorVolumeSampler;

float4x4 WorldToLocal;
float3 LocalBoxExtent;
float EdgeFalloff;
float ShadowColorVolumeWeight;
float DirectLightMaskThreshold;
float DirectLightMaskSoftness;
float BlendWeight;
uint OutputMode;
float Priority;
uint bShadowColorVolumeValid;
uint DebugView;
// [DeferredToon] Semantic bindings are packed in fixed-size arrays.  The
// registry can add providers without changing this shader's parameter layout.
uint4 InputIds[3];
uint4 InputChannels[3];
uint4 InputAvailability[3];
float4 InputWeights[3];
uint4 InputInverts[3];
uint4 InputOperations[3];
float4 InputDefaults[12];
uint InputNumLayers;
// [DeferredToon] Keep the HLSL declaration explicitly packed as four float4
// registers.  The matching C++ SHADER_PARAMETER_SCALAR_ARRAY(float, ...)
// uses UE's packed FVector4f representation; relying on the helper macro here
// produced a reflected float[16] layout on the editor's SM5 compiler and made
// global shader compilation fail before the editor could start.
float4 FalloffSamples[4];
float4 LightingColorSamples[16];
float4 ShadowColorSamples[16];

float SampleCurve(float Value)
{
	const float Position = saturate(Value) * 15.0f;
	const uint Index = min((uint)Position, 14u);
	return lerp(GET_SCALAR_ARRAY_ELEMENT(FalloffSamples, Index), GET_SCALAR_ARRAY_ELEMENT(FalloffSamples, Index + 1), frac(Position));
}

float4 SampleColorCurve(float Value, float4 Samples[16])
{
	const float Position = saturate(Value) * 15.0f;
	const uint Index = min((uint)Position, 14u);
	return lerp(Samples[Index], Samples[Index + 1], frac(Position));
}

float SelectDeferredToonChannel(float4 Value, uint Channel)
{
	switch (Channel)
	{
	case 1u: return Value.r;
	case 2u: return Value.g;
	case 3u: return Value.b;
	case 4u: return Value.a;
	case 5u: return dot(Value.rgb, float3(0.2126f, 0.7152f, 0.0722f));
	default: return Value.r;
	}
}

// [DeferredToon] Resolve one semantic layer against the current scene inputs.
// The evaluator owns source decoding; the box pass only consumes semantic data.
float4 EvaluateDeferredToonInput(uint LayerIndex, float2 UV, FGBufferData GBufferData)
{
	if (LayerIndex >= InputNumLayers)
	{
		return InputDefaults[LayerIndex];
	}

	const uint InputId = GET_SCALAR_ARRAY_ELEMENT(InputIds, LayerIndex);
	const uint Channel = GET_SCALAR_ARRAY_ELEMENT(InputChannels, LayerIndex);
	const uint bAvailable = GET_SCALAR_ARRAY_ELEMENT(InputAvailability, LayerIndex);
	if (bAvailable == 0u)
	{
		return InputDefaults[LayerIndex];
	}

	float4 SourceValue = InputDefaults[LayerIndex];
	switch (InputId)
	{
	case 1u: // DirectLight: unshadowed lighting contribution plus alpha mask.
		SourceValue = SceneTexturesStruct.LightingBufferTexture.SampleLevel(GlobalBilinearClampedSampler, UV, 0);
		break;
	case 2u: // NativeShadow: current-frame native visibility.
		SourceValue = float4(ShadowBufferTexture.SampleLevel(ShadowBufferSampler, UV, 0).rrr, 1.0f);
		break;
	case 3u: // ShadowChannel: subtraction mask exported in LightingBuffer alpha.
		SourceValue = float4(SceneTexturesStruct.LightingBufferTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).aaaa);
		break;
	case 4u: // AmbientOcclusion.
		SourceValue = SceneTexturesStruct.ScreenSpaceAOTexture.SampleLevel(SceneTexturesStruct_ScreenSpaceAOTextureSampler, UV, 0);
		break;
	case 5u: // BaseColor.
		SourceValue = float4(GBufferData.BaseColor, 1.0f);
		break;
	case 6u: // WorldNormal, encoded for stable color-space inspection.
		SourceValue = float4(GBufferData.WorldNormal * 0.5f + 0.5f, 1.0f);
		break;
	case 7u: // Roughness.
		SourceValue = float4(GBufferData.Roughness.xxx, 1.0f);
		break;
	case 8u: // ShadingModel.
		SourceValue = float4((float)GBufferData.ShadingModelID / 255.0f, 0.0f, 0.0f, 1.0f);
		break;
	case 9u: // Linearized depth from the decoded GBuffer surface position.
		SourceValue = float4(GBufferData.Depth.xxx, 1.0f);
		break;
	case 10u: // Velocity is encoded in the scene-texture uniform.
		SourceValue = SceneTexturesStruct.GBufferVelocityTexture.SampleLevel(GlobalPointClampedSampler, UV, 0);
		break;
	case 11u: // SpecularDirectLight: unshadowed direct specular contribution.
		SourceValue = SpecularBufferTexture.SampleLevel(SpecularBufferSampler, UV, 0);
		break;
	default:
		return InputDefaults[LayerIndex];
	}

	const float SelectedValue = SelectDeferredToonChannel(SourceValue, Channel);
	return Channel == 0u ? SourceValue : float4(SelectedValue.xxx, SelectedValue);
}

// [DeferredToon] Compose the fixed first-stage semantic stack.  The operation
// is selected from packed data so adding a layer never creates a permutation.
void ComposeDeferredToonStyleLayers(
	float2 UV,
	FGBufferData GBufferData,
	out float3 StyleColor,
	out float StyleMask)
{
	StyleColor = 1.0f.xxx;
	StyleMask = 0.0f;
	for (uint LayerIndex = 0u; LayerIndex < InputNumLayers; ++LayerIndex)
	{
		float4 InputValue = EvaluateDeferredToonInput(LayerIndex, UV, GBufferData);
		const uint bInvert = GET_SCALAR_ARRAY_ELEMENT(InputInverts, LayerIndex);
		const float LayerWeight = saturate(GET_SCALAR_ARRAY_ELEMENT(InputWeights, LayerIndex));
		const uint Operation = GET_SCALAR_ARRAY_ELEMENT(InputOperations, LayerIndex);
		if (bInvert != 0u)
		{
			InputValue = 1.0f.xxxx - InputValue;
		}

		const float LayerScalar = saturate(dot(InputValue.rgb, float3(0.2126f, 0.7152f, 0.0722f)));
		StyleMask = max(StyleMask, LayerScalar * LayerWeight);
		if (Operation == 1u)
		{
			StyleColor += InputValue.rgb * LayerWeight;
		}
		else if (Operation == 2u)
		{
			StyleColor = lerp(StyleColor, InputValue.rgb, LayerWeight);
		}
		else
		{
			StyleColor *= lerp(1.0f.xxx, InputValue.rgb, LayerWeight);
		}
	}
}

void MainPS(
	noperspective float4 UVAndScreenPos : TEXCOORD0,
	FStereoVSOutput StereoOutput,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 UV = clamp(UVAndScreenPos.xy, Input_UVViewportBilinearMin, Input_UVViewportBilinearMax);
	float4 SceneColor = Texture2DSampleLevel(SceneColorTexture, SceneColorSampler, UV, 0);
	const float DeviceZ = SceneTexturesStruct.SceneDepthTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).r;
	// [DeferredToon] The depth texture stores device Z; reconstruct linear depth before inverse projection.
	const float SceneDepth = ConvertFromDeviceZ(DeviceZ);
	// [DeferredToon] UV is a texture coordinate.  World reconstruction needs the
	// clip-space screen position generated by DrawRectangle (TEXCOORD0.zw).
	// Using UV here made the box test depend on the camera being inside the box.
	const float2 ScreenPosition = UVAndScreenPos.zw;
	const float3 TranslatedWorldPosition = mul(float4(GetScreenPositionForProjectionType(ScreenPosition, SceneDepth), SceneDepth, 1.0f), PrimaryView.ScreenToTranslatedWorld).xyz;
	// [DeferredToon] WorldToLocal is an absolute-world transform; remove the view translation first.
	const float3 WorldPosition = DFFastSubtractDemote(TranslatedWorldPosition, PrimaryView.PreViewTranslation);
	const float3 LocalPosition = mul(float4(WorldPosition, 1.0f), WorldToLocal).xyz;
	// GBuffer presence distinguishes real deferred surfaces from sky/background pixels.
	const FGBufferData GBufferData = GetGBufferData(UV);
	// [DeferredToon] Resolve the fixed first-stage stack through semantic IDs;
	// profiles later provide the same evaluator with authored layers.
	const float4 DirectLightInput = EvaluateDeferredToonInput(0u, UV, GBufferData);
	const float4 NativeShadowInput = EvaluateDeferredToonInput(1u, UV, GBufferData);
	const float4 ShadowChannelInput = EvaluateDeferredToonInput(2u, UV, GBufferData);
	const float4 AmbientOcclusionInput = EvaluateDeferredToonInput(3u, UV, GBufferData);
	const float4 BaseColorInput = EvaluateDeferredToonInput(4u, UV, GBufferData);
	const float4 WorldNormalInput = EvaluateDeferredToonInput(5u, UV, GBufferData);
	const float4 RoughnessInput = EvaluateDeferredToonInput(6u, UV, GBufferData);
	const float4 ShadingModelInput = EvaluateDeferredToonInput(7u, UV, GBufferData);
	const float4 SpecularDirectLightInput = EvaluateDeferredToonInput(10u, UV, GBufferData);
	float3 StyleColor;
	float StyleMask;
	ComposeDeferredToonStyleLayers(UV, GBufferData, StyleColor, StyleMask);
	// Keep the named values live in this first-stage pass so shader compilers do
	// not remove the contract before later layer composition is added.
	const float SemanticInputKeepAlive = DirectLightInput.a + AmbientOcclusionInput.a + BaseColorInput.a + WorldNormalInput.a + RoughnessInput.a + ShadingModelInput.a + SpecularDirectLightInput.a;
	const float3 NormalizedPosition = LocalPosition / max(LocalBoxExtent * 2.0f, 1e-3f) + 0.5f;
	const float3 DistanceToEdge = min(NormalizedPosition, 1.0f - NormalizedPosition);
	const float EdgeDistance = min(DistanceToEdge.x, min(DistanceToEdge.y, DistanceToEdge.z));
	// [DeferredToon] Use the pixel footprint of the signed box distance as a
	// minimum edge width. The previous hard step at each face shimmered under
	// editor camera/TSR jitter, especially when EdgeFalloff was zero.
	const float EdgeAAWidth = max(fwidth(EdgeDistance), 1e-4f);
	const float EdgeWidth = max(EdgeFalloff * 0.5f, EdgeAAWidth);
	const float BoxWeight = smoothstep(0.0f, EdgeWidth, EdgeDistance);
	const float FalloffWeight = SampleCurve(BoxWeight);
	const float SurfaceMask = saturate(dot(GBufferData.WorldNormal, GBufferData.WorldNormal));
	const float Weight = saturate(BoxWeight * FalloffWeight * BlendWeight) * SurfaceMask;

	const float4 LightingBufferSample = DirectLightInput;
	const float LightingValue = dot(max(LightingBufferSample.rgb, 0.0f), float3(0.2126f, 0.7152f, 0.0722f));
	// [DeferredToon] Native UE occlusion and Shadow Channel subtraction are
	// exported separately. Both masks use this same box weight, then form a
	// union so overlapping masks do not apply the tint twice.
	// [DeferredToon] Use the current-frame native scalar supplied by the
	// ShadowBuffer semantic. LightingBuffer remains the native accumulation.
	const float NativeShadowMask = saturate(NativeShadowInput.r);
	// LightingBufferSample.a is now resolved through the ShadowChannel semantic;
	// retaining this source name documents the channel contract for legacy users.
	const float ShadowChannelMask = saturate(ShadowChannelInput.r);
	const float NativeShadowContribution = NativeShadowMask;
	const float ShadowChannelContribution = ShadowChannelMask * (1.0f - NativeShadowMask);
	const float CombinedShadowMask = saturate(NativeShadowContribution + ShadowChannelContribution);
	const float4 LightingColor = SampleColorCurve(saturate(LightingValue), LightingColorSamples);
	const float4 NativeShadowCurveColor = SampleColorCurve(NativeShadowMask, ShadowColorSamples);
	const float4 ShadowChannelCurveColor = SampleColorCurve(ShadowChannelMask, ShadowColorSamples);
	const float4 VolumeColor = bShadowColorVolumeValid != 0 ? Texture3DSampleLevel(ShadowColorVolume, ShadowColorVolumeSampler, saturate(NormalizedPosition), 0) : ShadowChannelCurveColor;
	const float3 ShadowChannelTint = lerp(ShadowChannelCurveColor.rgb, VolumeColor.rgb, saturate(ShadowColorVolumeWeight));
	const float3 ShadowTint = CombinedShadowMask > 1e-4f
		? (NativeShadowCurveColor.rgb * NativeShadowContribution + ShadowChannelTint * ShadowChannelContribution) / CombinedShadowMask
		: 1.0f.xxx;
	// [DeferredToon] Keep the masks independent. DirectLightMask describes
	// illumination strength; NativeShadowMask and ShadowChannelMask describe
	// occlusion sources. The first toon pass uses a strict binary split so the
	// direct-light debug mask has no soft gradient between lit and unlit areas.
	// DirectLightMaskSoftness remains reserved for a future opt-in soft mode.
	const float DirectLightMask = step(DirectLightMaskThreshold, LightingValue);

	if (DebugView == 1)
	{
		OutColor = float4(Weight.xxx, 1.0f);
	}
	else if (DebugView == 2)
	{
		// [DeferredToon] Show the actual affected region.  Displaying the raw
		// curve color made a white curve look like a full-screen pass even when
		// the volume did not cover the pixel.
		OutColor = float4(ShadowTint * CombinedShadowMask * Weight, 1.0f);
	}
	else if (DebugView == 3)
	{
		OutColor = float4(saturate(abs(Priority) / 16.0f).xxx, 1.0f);
	}
	else if (DebugView == 4)
	{
		OutColor = float4(saturate(DirectLightInput.rgb), 1.0f);
	}
	else if (DebugView == 5)
	{
		OutColor = float4(NativeShadowInput.rrr, 1.0f);
	}
	else if (DebugView == 6)
	{
		OutColor = float4(ShadowChannelInput.rrr, 1.0f);
	}
	else if (DebugView == 7)
	{
		OutColor = float4(saturate(BaseColorInput.rgb), 1.0f);
	}
	else if (DebugView == 8)
	{
		OutColor = float4(saturate(WorldNormalInput.rgb), 1.0f);
	}
	else if (DebugView == 9)
	{
		OutColor = float4(AmbientOcclusionInput.rrr, 1.0f);
	}
	else if (DebugView == 10)
	{
		OutColor = float4(StyleMask.xxx, 1.0f);
	}
	else if (DebugView == 11)
	{
		OutColor = float4(saturate(StyleColor), 1.0f);
	}
	else if (DebugView == 12)
	{
		// [DeferredToon] Display linear depth with a fixed 100 m reference range
		// so nearby geometry remains readable without changing the semantic value.
		OutColor = float4(saturate(GBufferData.Depth / 10000.0f).xxx, 1.0f);
	}
	else if (DebugView == 13)
	{
		// [DeferredToon] Motion vectors are signed; remap them around 0.5 so
		// forward/backward and left/right motion remain visible in the preview.
		const float3 EncodedVelocity = SceneTexturesStruct.GBufferVelocityTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).rgb;
		OutColor = float4(saturate(EncodedVelocity * 0.5f + 0.5f), 1.0f);
	}
	else if (DebugView == 14)
	{
		// [DeferredToon] DirectLight illumination mask before style mapping.
		OutColor = float4(DirectLightMask.xxx, 1.0f);
	}
	else if (DebugView == 15)
	{
		// [DeferredToon] Native UE occlusion mask from ShadowBuffer.
		OutColor = float4(NativeShadowMask.xxx, 1.0f);
	}
	else if (DebugView == 16)
	{
		// [DeferredToon] Shadow Channel subtraction mask.
		OutColor = float4(ShadowChannelMask.xxx, 1.0f);
	}
	else if (DebugView == 17)
	{
		// [DeferredToon] Union of the native and channel shadow masks.
		OutColor = float4(CombinedShadowMask.xxx, 1.0f);
	}
	else if (DebugView == 18)
	{
		// [DeferredToon] Direct specular contribution is visible independently
		// so roughness/highlight energy cannot contaminate DirectLight debug.
		OutColor = float4(max(SpecularDirectLightInput.rgb, 0.0f), 1.0f);
	}
	else
	{
		// [DeferredToon] Keep each output policy explicit. NativeComposite is
		// mode 0 and preserves the original scene-color path byte-for-byte in
		// behavior; the other modes opt into the staged RT composition.
		const float3 MappedLighting = SceneColor.rgb * max(LightingColor.rgb, 0.0f);
		const float3 ShadowedLighting = MappedLighting * lerp(1.0f.xxx, ShadowTint, CombinedShadowMask);
		const float3 NativeCompositeColor = lerp(SceneColor.rgb, ShadowedLighting, Weight);
		// [DeferredToon] RecomposeDiffuse starts from GBuffer base color and the
		// direct-light RT, then applies the volume's shadow and semantic style.
		// It intentionally stays behind an explicit mode so existing content is
		// unaffected while additional RT layers are still being integrated.
		const float3 RecomposedDiffuseColor = BaseColorInput.rgb
			* max(LightingBufferSample.rgb, 0.0f)
			* lerp(1.0f.xxx, ShadowTint, CombinedShadowMask)
			* max(StyleColor, 0.0f.xxx);
		const float3 RecomposeOutput = lerp(SceneColor.rgb, RecomposedDiffuseColor, Weight);
		// [DeferredToon] Replace exposes the authored semantic style directly;
		// this is useful for validating a profile before adding more operations.
		const float3 ReplaceOutput = lerp(SceneColor.rgb, StyleColor, Weight);
		float3 OutputColor;
		if (OutputMode == 0u)
		{
			OutputColor = NativeCompositeColor;
		}
		else if (OutputMode == 1u)
		{
			OutputColor = RecomposeOutput;
		}
		else if (OutputMode == 2u)
		{
			OutputColor = ReplaceOutput;
		}
		OutColor = float4(OutputColor, SceneColor.a);
	}
}
