#include "Common.ush"
#include "DeferredShadingCommon.ush"
#include "PostProcessCommon.ush"
#include "ScreenPass.ush"

// [DeferredToon] Linear HDR mapping from scene inputs inside each authored box.
SCREEN_PASS_TEXTURE_VIEWPORT(Input)

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
Texture2D ShadowBufferTexture;
SamplerState ShadowBufferSampler;
Texture3D ShadowColorVolume;
SamplerState ShadowColorVolumeSampler;

float4x4 WorldToLocal;
float3 LocalBoxExtent;
float EdgeFalloff;
float ShadowColorVolumeWeight;
float BlendWeight;
float Priority;
uint bShadowColorVolumeValid;
uint DebugView;
// [DeferredToon] Keep the HLSL declaration explicitly packed as four float4
// registers.  The matching C++ SHADER_PARAMETER_SCALAR_ARRAY(float, ...)
// uses UE's packed FVector4f representation; relying on the helper macro here
// produced a reflected float[16] layout on the editor's SM5 compiler and made
// global shader compilation fail before the editor could start.
float4 FalloffSamples[4];
float4 LightingColorSamples[16];
float4 ShadowColorSamples[16];

float SampleCurve(float Value)
{
	const float Position = saturate(Value) * 15.0f;
	const uint Index = min((uint)Position, 14u);
	return lerp(GET_SCALAR_ARRAY_ELEMENT(FalloffSamples, Index), GET_SCALAR_ARRAY_ELEMENT(FalloffSamples, Index + 1), frac(Position));
}

float4 SampleColorCurve(float Value, float4 Samples[16])
{
	const float Position = saturate(Value) * 15.0f;
	const uint Index = min((uint)Position, 14u);
	return lerp(Samples[Index], Samples[Index + 1], frac(Position));
}

void MainPS(
	noperspective float4 UVAndScreenPos : TEXCOORD0,
	FStereoVSOutput StereoOutput,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 UV = clamp(UVAndScreenPos.xy, Input_UVViewportBilinearMin, Input_UVViewportBilinearMax);
	float4 SceneColor = Texture2DSampleLevel(SceneColorTexture, SceneColorSampler, UV, 0);
	const float DeviceZ = SceneTexturesStruct.SceneDepthTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).r;
	// [DeferredToon] The depth texture stores device Z; reconstruct linear depth before inverse projection.
	const float SceneDepth = ConvertFromDeviceZ(DeviceZ);
	// [DeferredToon] UV is a texture coordinate.  World reconstruction needs the
	// clip-space screen position generated by DrawRectangle (TEXCOORD0.zw).
	// Using UV here made the box test depend on the camera being inside the box.
	const float2 ScreenPosition = UVAndScreenPos.zw;
	const float3 TranslatedWorldPosition = mul(float4(GetScreenPositionForProjectionType(ScreenPosition, SceneDepth), SceneDepth, 1.0f), PrimaryView.ScreenToTranslatedWorld).xyz;
	// [DeferredToon] WorldToLocal is an absolute-world transform; remove the view translation first.
	const float3 WorldPosition = DFFastSubtractDemote(TranslatedWorldPosition, PrimaryView.PreViewTranslation);
	const float3 LocalPosition = mul(float4(WorldPosition, 1.0f), WorldToLocal).xyz;
	// GBuffer presence distinguishes real deferred surfaces from sky/background pixels.
	const FGBufferData GBufferData = GetGBufferData(UV);
	const float3 NormalizedPosition = LocalPosition / max(LocalBoxExtent * 2.0f, 1e-3f) + 0.5f;
	const float3 DistanceToEdge = min(NormalizedPosition, 1.0f - NormalizedPosition);
	const float EdgeDistance = min(DistanceToEdge.x, min(DistanceToEdge.y, DistanceToEdge.z));
	// [DeferredToon] Use the pixel footprint of the signed box distance as a
	// minimum edge width. The previous hard step at each face shimmered under
	// editor camera/TSR jitter, especially when EdgeFalloff was zero.
	const float EdgeAAWidth = max(fwidth(EdgeDistance), 1e-4f);
	const float EdgeWidth = max(EdgeFalloff * 0.5f, EdgeAAWidth);
	const float BoxWeight = smoothstep(0.0f, EdgeWidth, EdgeDistance);
	const float FalloffWeight = SampleCurve(BoxWeight);
	const float SurfaceMask = saturate(dot(GBufferData.WorldNormal, GBufferData.WorldNormal));
	const float Weight = saturate(BoxWeight * FalloffWeight * BlendWeight) * SurfaceMask;

	const float4 LightingBufferSample = SceneTexturesStruct.LightingBufferTexture.SampleLevel(GlobalBilinearClampedSampler, UV, 0);
	const float LightingValue = dot(LightingBufferSample.rgb, float3(0.2126f, 0.7152f, 0.0722f));
	// [DeferredToon] Native UE occlusion and Shadow Channel subtraction are
	// exported separately. Both masks use this same box weight, then form a
	// union so overlapping masks do not apply the tint twice.
	// [DeferredToon] Use the temporally stabilized scalar supplied by the C++
	// pass.  LightingBuffer remains the native current-frame accumulation.
	const float NativeShadowValue = saturate(ShadowBufferTexture.SampleLevel(ShadowBufferSampler, UV, 0).r);
	const float ShadowChannelValue = saturate(LightingBufferSample.a);
	const float NativeShadowContribution = NativeShadowValue;
	const float ShadowChannelContribution = ShadowChannelValue * (1.0f - NativeShadowValue);
	const float CombinedShadowValue = saturate(NativeShadowContribution + ShadowChannelContribution);
	const float4 LightingColor = SampleColorCurve(saturate(LightingValue), LightingColorSamples);
	const float4 NativeShadowCurveColor = SampleColorCurve(NativeShadowValue, ShadowColorSamples);
	const float4 ShadowChannelCurveColor = SampleColorCurve(ShadowChannelValue, ShadowColorSamples);
	const float4 VolumeColor = bShadowColorVolumeValid != 0 ? Texture3DSampleLevel(ShadowColorVolume, ShadowColorVolumeSampler, saturate(NormalizedPosition), 0) : ShadowChannelCurveColor;
	const float3 ShadowChannelTint = lerp(ShadowChannelCurveColor.rgb, VolumeColor.rgb, saturate(ShadowColorVolumeWeight));
	const float3 ShadowTint = CombinedShadowValue > 1e-4f
		? (NativeShadowCurveColor.rgb * NativeShadowContribution + ShadowChannelTint * ShadowChannelContribution) / CombinedShadowValue
		: 1.0f.xxx;

	if (DebugView == 1)
	{
		OutColor = float4(Weight.xxx, 1.0f);
	}
	else if (DebugView == 2)
	{
		// [DeferredToon] Show the actual affected region.  Displaying the raw
		// curve color made a white curve look like a full-screen pass even when
		// the volume did not cover the pixel.
		OutColor = float4(ShadowTint * CombinedShadowValue * Weight, 1.0f);
	}
	else if (DebugView == 3)
	{
		OutColor = float4(saturate(abs(Priority) / 16.0f).xxx, 1.0f);
	}
	else
	{
		const float3 MappedLighting = SceneColor.rgb * max(LightingColor.rgb, 0.0f);
		const float3 ShadowedLighting = MappedLighting * lerp(1.0f.xxx, ShadowTint, CombinedShadowValue);
		OutColor = float4(lerp(SceneColor.rgb, ShadowedLighting, Weight), SceneColor.a);
	}
}
