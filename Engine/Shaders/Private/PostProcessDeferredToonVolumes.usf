#include "Common.ush"
#include "DeferredShadingCommon.ush"
#include "PostProcessCommon.ush"
#include "ScreenPass.ush"

// [DeferredToon] Linear HDR mapping from scene inputs inside each authored box.
SCREEN_PASS_TEXTURE_VIEWPORT(Input)

Texture2D SceneColorTexture;
Texture2D OriginalSceneColorTexture; // [DeferredToon] Immutable residual source for overlapping volumes.
SamplerState SceneColorSampler;
Texture2D ShadowBufferTexture;
SamplerState ShadowBufferSampler;
// [DeferredToon] Separate direct-specular input; DirectLight remains diffuse-only.
Texture2D SpecularBufferTexture;
SamplerState SpecularBufferSampler;
Texture3D ShadowColorVolume;
SamplerState ShadowColorVolumeSampler;

float4x4 WorldToLocal;
float3 LocalBoxExtent;
float EdgeFalloff;
float ShadowColorVolumeWeight;
float BlendWeight;
uint OutputMode;
// [DeferredToon] Independent reconstruction uses scene-linear authored colors.
float BaseColorWeight;
float ToonShadowThreshold;
float4 ToonLitColor;
float4 ToonDarkColor;
// [DeferredToon] Effective-light selection and optional color texture.
Texture2D ShadowTexture;
SamplerState ShadowTextureSampler;
uint bShadowTextureValid;
uint bEffectiveLightAvailable;
Texture2D EffectiveLightBufferTexture; // [DeferredToon] Explicit current-frame provider.
float EffectiveLightThreshold;
// [DeferredToon] Packed by the proxy: lower bound, output level, texture weight, replace weight.
uint LightBandCount;
float4 LightBandParams[8];
float4 LightBandColors[8];
float LitColorReplaceWeight;
float ShadowColorReplaceWeight;
float OtherLightingWeight;
float ShadowTextureWeight;
float2 ShadowTextureTiling;
float2 ShadowTextureOffset;
float Priority;
uint bShadowColorVolumeValid;
uint DebugView;
// [DeferredToon] Semantic bindings are packed in fixed-size arrays.  The
// registry can add providers without changing this shader's parameter layout.
uint4 InputIds[3];
uint4 InputChannels[3];
uint4 InputAvailability[3];
float4 InputWeights[3];
uint4 InputInverts[3];
uint4 InputOperations[3];
float4 InputDefaults[12];
uint InputNumLayers;
// [DeferredToon] Keep the HLSL declaration explicitly packed as four float4
// registers.  The matching C++ SHADER_PARAMETER_SCALAR_ARRAY(float, ...)
// uses UE's packed FVector4f representation; relying on the helper macro here
// produced a reflected float[16] layout on the editor's SM5 compiler and made
// global shader compilation fail before the editor could start.
float4 FalloffSamples[4];
float4 LightingColorSamples[16];

float SampleCurve(float Value)
{
	const float Position = saturate(Value) * 15.0f;
	const uint Index = min((uint)Position, 14u);
	return lerp(GET_SCALAR_ARRAY_ELEMENT(FalloffSamples, Index), GET_SCALAR_ARRAY_ELEMENT(FalloffSamples, Index + 1), frac(Position));
}

float4 SampleColorCurve(float Value, float4 Samples[16])
{
	const float Position = saturate(Value) * 15.0f;
	const uint Index = min((uint)Position, 14u);
	return lerp(Samples[Index], Samples[Index + 1], frac(Position));
}

// [DeferredToon] Storage is packed, but the semantic is independent of specular.
// Point sampling matches the current-frame GBuffer pixel before TAA/TSR.
float SampleDeferredToonFacing(float2 UV)
{
	return saturate(SpecularBufferTexture.SampleLevel(SpecularBufferSampler, UV, 0).a);
}

// [DeferredToon] Hard intervals: exact boundaries choose the higher band.
// Zero physical light and an explicit artistic shadow override select the first band.
uint SelectDeferredToonLightBand(float Response, float ArtisticShadow)
{
    uint Selected = 0u;
    if (Response > 0.0f && ArtisticShadow < ToonShadowThreshold)
    {
        for (uint Index = 1u; Index < min(LightBandCount, 8u); ++Index)
        {
            if (Response >= LightBandParams[Index].x)
            {
                Selected = Index;
            }
        }
    }
    return Selected;
}

float SelectDeferredToonChannel(float4 Value, uint Channel)
{
	switch (Channel)
	{
	case 1u: return Value.r;
	case 2u: return Value.g;
	case 3u: return Value.b;
	case 4u: return Value.a;
	case 5u: return dot(Value.rgb, float3(0.2126f, 0.7152f, 0.0722f));
	default: return Value.r;
	}
}

// [DeferredToon] Resolve one semantic layer against the current scene inputs.
// The evaluator owns source decoding; the box pass only consumes semantic data.
float4 EvaluateDeferredToonInput(uint LayerIndex, float2 UV, FGBufferData GBufferData)
{
	if (LayerIndex >= InputNumLayers)
	{
		return InputDefaults[LayerIndex];
	}

	const uint InputId = GET_SCALAR_ARRAY_ELEMENT(InputIds, LayerIndex);
	const uint Channel = GET_SCALAR_ARRAY_ELEMENT(InputChannels, LayerIndex);
	const uint bAvailable = GET_SCALAR_ARRAY_ELEMENT(InputAvailability, LayerIndex);
	if (bAvailable == 0u)
	{
		return InputDefaults[LayerIndex];
	}

	float4 SourceValue = InputDefaults[LayerIndex];
	switch (InputId)
	{
	case 1u: // DirectLight: unshadowed lighting contribution plus alpha mask.
		SourceValue = SceneTexturesStruct.LightingBufferTexture.SampleLevel(GlobalBilinearClampedSampler, UV, 0);
		break;
	case 2u: // NativeShadow: current-frame native visibility.
		SourceValue = float4(ShadowBufferTexture.SampleLevel(ShadowBufferSampler, UV, 0).rrr, 1.0f);
		break;
	case 3u: // ShadowChannel: subtraction mask exported in LightingBuffer alpha.
		SourceValue = float4(SceneTexturesStruct.LightingBufferTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).aaaa);
		break;
	case 4u: // AmbientOcclusion.
		SourceValue = SceneTexturesStruct.ScreenSpaceAOTexture.SampleLevel(SceneTexturesStruct_ScreenSpaceAOTextureSampler, UV, 0);
		break;
	case 5u: // BaseColor.
		SourceValue = float4(GBufferData.BaseColor, 1.0f);
		break;
	case 6u: // WorldNormal, encoded for stable color-space inspection.
		SourceValue = float4(GBufferData.WorldNormal * 0.5f + 0.5f, 1.0f);
		break;
	case 7u: // Roughness.
		SourceValue = float4(GBufferData.Roughness.xxx, 1.0f);
		break;
	case 8u: // ShadingModel.
		SourceValue = float4((float)GBufferData.ShadingModelID / 255.0f, 0.0f, 0.0f, 1.0f);
		break;
	case 9u: // Linearized depth from the decoded GBuffer surface position.
		SourceValue = float4(GBufferData.Depth.xxx, 1.0f);
		break;
	case 10u: // Velocity is encoded in the scene-texture uniform.
		SourceValue = SceneTexturesStruct.GBufferVelocityTexture.SampleLevel(GlobalPointClampedSampler, UV, 0);
		break;
	case 11u: // SpecularDirectLight: unshadowed direct specular contribution.
		// [DeferredToon] Do not expose the packed facing value as specular alpha.
		SourceValue = float4(SpecularBufferTexture.SampleLevel(SpecularBufferSampler, UV, 0).rgb, 0.0f);
		break;
	case 12u: // [DeferredToon] DirectLightFacing: max positive N.L of eligible lights.
		SourceValue = SampleDeferredToonFacing(UV).xxxx;
		break;
    // [DeferredToon] Both new semantics use scene-linear units, not display exposure.
    case 13u:
        SourceValue = float4(EffectiveLightBufferTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).rgb * PrimaryView.OneOverPreExposure, 1.0f);
        break;
    case 14u:
        SourceValue = (EffectiveLightBufferTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).a * PrimaryView.OneOverPreExposure).xxxx;
        break;
	default:
		return InputDefaults[LayerIndex];
	}

	const float SelectedValue = SelectDeferredToonChannel(SourceValue, Channel);
	return Channel == 0u ? SourceValue : float4(SelectedValue.xxx, SelectedValue);
}

// [DeferredToon] Compose the fixed first-stage semantic stack.  The operation
// is selected from packed data so adding a layer never creates a permutation.
void ComposeDeferredToonStyleLayers(
	float2 UV,
	FGBufferData GBufferData,
	out float3 StyleColor,
	out float StyleMask)
{
	StyleColor = 1.0f.xxx;
	StyleMask = 0.0f;
	for (uint LayerIndex = 0u; LayerIndex < InputNumLayers; ++LayerIndex)
	{
		float4 InputValue = EvaluateDeferredToonInput(LayerIndex, UV, GBufferData);
		const uint bInvert = GET_SCALAR_ARRAY_ELEMENT(InputInverts, LayerIndex);
		const float LayerWeight = saturate(GET_SCALAR_ARRAY_ELEMENT(InputWeights, LayerIndex));
		const uint Operation = GET_SCALAR_ARRAY_ELEMENT(InputOperations, LayerIndex);
		if (bInvert != 0u)
		{
			InputValue = 1.0f.xxxx - InputValue;
		}

		const float LayerScalar = saturate(dot(InputValue.rgb, float3(0.2126f, 0.7152f, 0.0722f)));
		StyleMask = max(StyleMask, LayerScalar * LayerWeight);
		if (Operation == 1u)
		{
			StyleColor += InputValue.rgb * LayerWeight;
		}
		else if (Operation == 2u)
		{
			StyleColor = lerp(StyleColor, InputValue.rgb, LayerWeight);
		}
		else
		{
			StyleColor *= lerp(1.0f.xxx, InputValue.rgb, LayerWeight);
		}
	}
}

void MainPS(
	noperspective float4 UVAndScreenPos : TEXCOORD0,
	FStereoVSOutput StereoOutput,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 UV = clamp(UVAndScreenPos.xy, Input_UVViewportBilinearMin, Input_UVViewportBilinearMax);
	float4 SceneColor = Texture2DSampleLevel(SceneColorTexture, SceneColorSampler, UV, 0);
	const float DeviceZ = SceneTexturesStruct.SceneDepthTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).r;
	// [DeferredToon] The depth texture stores device Z; reconstruct linear depth before inverse projection.
	const float SceneDepth = ConvertFromDeviceZ(DeviceZ);
	// [DeferredToon] UV is a texture coordinate.  World reconstruction needs the
	// clip-space screen position generated by DrawRectangle (TEXCOORD0.zw).
	// Using UV here made the box test depend on the camera being inside the box.
	const float2 ScreenPosition = UVAndScreenPos.zw;
	const float3 TranslatedWorldPosition = mul(float4(GetScreenPositionForProjectionType(ScreenPosition, SceneDepth), SceneDepth, 1.0f), PrimaryView.ScreenToTranslatedWorld).xyz;
	// [DeferredToon] WorldToLocal is an absolute-world transform; remove the view translation first.
	const float3 WorldPosition = DFFastSubtractDemote(TranslatedWorldPosition, PrimaryView.PreViewTranslation);
	const float3 LocalPosition = mul(float4(WorldPosition, 1.0f), WorldToLocal).xyz;
	// GBuffer presence distinguishes real deferred surfaces from sky/background pixels.
	const FGBufferData GBufferData = GetGBufferData(UV);
	// [DeferredToon] Canonical inputs never depend on authored layer order.
	const float4 DirectLightInput = SceneTexturesStruct.LightingBufferTexture.SampleLevel(GlobalPointClampedSampler, UV, 0);
	const float4 BaseColorInput = float4(GBufferData.BaseColor, 1.0f);
	float3 StyleColor = 1.0f.xxx;
	float StyleMask = 0.0f;
	// [DeferredToon] Evaluate user layers only for their output/inspection path.
	if (OutputMode == 2u || DebugView == 10u || DebugView == 11u)
	{
		ComposeDeferredToonStyleLayers(UV, GBufferData, StyleColor, StyleMask);
	}
	const float3 NormalizedPosition = LocalPosition / max(LocalBoxExtent * 2.0f, 1e-3f) + 0.5f;
	const float3 DistanceToEdge = min(NormalizedPosition, 1.0f - NormalizedPosition);
	const float EdgeDistance = min(DistanceToEdge.x, min(DistanceToEdge.y, DistanceToEdge.z));
	// [DeferredToon] Use the pixel footprint of the signed box distance as a
	// minimum edge width. The previous hard step at each face shimmered under
	// editor camera/TSR jitter, especially when EdgeFalloff was zero.
	const float EdgeAAWidth = max(fwidth(EdgeDistance), 1e-4f);
	const float EdgeWidth = max(EdgeFalloff * 0.5f, EdgeAAWidth);
	const float BoxWeight = smoothstep(0.0f, EdgeWidth, EdgeDistance);
	const float FalloffWeight = SampleCurve(BoxWeight);
	const float SurfaceMask = saturate(dot(GBufferData.WorldNormal, GBufferData.WorldNormal));
	const float Weight = saturate(BoxWeight * FalloffWeight * BlendWeight) * SurfaceMask;

	// [DeferredToon] One production selector: native per-light visibility is
	// applied BEFORE accumulation. Never reapply the aggregate occlusion mask.
	const float DirectLightFacing = SampleDeferredToonFacing(UV); // Diagnostic/art input only.
	const float4 EffectiveLight = max(EffectiveLightBufferTexture.SampleLevel(GlobalPointClampedSampler, UV, 0)
		* PrimaryView.OneOverPreExposure, 0.0f);
	const float EffectiveLitMask = EffectiveLight.a > 0.0f ? step(max(EffectiveLightThreshold, 0.0f), EffectiveLight.a) : 0.0f;
	const float DirectLightMask = EffectiveLitMask;
	const float NativeShadowMask = saturate(ShadowBufferTexture.SampleLevel(ShadowBufferSampler, UV, 0).r);
	const float ShadowChannelMask = saturate(DirectLightInput.a);
	// [DeferredToon] This union is diagnostic only; it does not drive surface colors.
	const float CombinedShadowMask = saturate(NativeShadowMask + ShadowChannelMask * (1.0f - NativeShadowMask));
	const float ToonShadowMask = saturate(1.0f - DirectLightMask * (1.0f - ShadowChannelMask));
	const float ToonBinaryShadowMask = step(ToonShadowThreshold, ToonShadowMask);
	const float4 VolumeColor = bShadowColorVolumeValid != 0
		? Texture3DSampleLevel(ShadowColorVolume, ShadowColorVolumeSampler, saturate(NormalizedPosition), 0)
		: ToonDarkColor;

    // [DeferredToon] Box-local triplanar mapping. Use geometric derivatives for
    // projection weights, so non-uniform box scale and material normals do not swim.
    float3 ProjectionWeight = abs(cross(ddx(LocalPosition), ddy(LocalPosition)));
    ProjectionWeight /= max(max(ProjectionWeight.x, max(ProjectionWeight.y, ProjectionWeight.z)), 1e-8f);
    ProjectionWeight = pow(ProjectionWeight, 4.0f);
    ProjectionWeight /= max(dot(ProjectionWeight, 1.0f.xxx), 1e-8f);
    float4 ShadowTexel = 0.0f;
    if (bShadowTextureValid != 0u)
    {
        ShadowTexel = Texture2DSample(ShadowTexture, ShadowTextureSampler, NormalizedPosition.yz * ShadowTextureTiling + ShadowTextureOffset) * ProjectionWeight.x
            + Texture2DSample(ShadowTexture, ShadowTextureSampler, NormalizedPosition.zx * ShadowTextureTiling + ShadowTextureOffset) * ProjectionWeight.y
            + Texture2DSample(ShadowTexture, ShadowTextureSampler, NormalizedPosition.xy * ShadowTextureTiling + ShadowTextureOffset) * ProjectionWeight.z;
    }
    float3 AuthoredShadowColor = max(ToonDarkColor.rgb, 0.0f);
    if (bShadowColorVolumeValid != 0u)
    {
        AuthoredShadowColor = lerp(AuthoredShadowColor, max(VolumeColor.rgb, 0.0f), saturate(ShadowColorVolumeWeight));
    }
    AuthoredShadowColor = lerp(AuthoredShadowColor, max(ShadowTexel.rgb, 0.0f),
        saturate(ShadowTextureWeight) * saturate(ShadowTexel.a));
    const float3 AuthoredBase = lerp(1.0f.xxx, GBufferData.BaseColor, saturate(BaseColorWeight));

    // [DeferredToon] Both output modes consume one palette result. A disabled
    // palette preserves the previous two-band endpoint/texture behavior exactly.
    const uint SelectedLightBand = SelectDeferredToonLightBand(EffectiveLight.a, ShadowChannelMask);
    const float SelectedLightBandValue = LightBandCount > 0u ? LightBandParams[SelectedLightBand].y : 1.0f - ToonBinaryShadowMask;
    float MappedBandColorWeight = lerp(LitColorReplaceWeight, ShadowColorReplaceWeight, ToonBinaryShadowMask);
    float3 MappedBandColor = lerp(max(ToonLitColor.rgb, 0.0f), AuthoredShadowColor, ToonBinaryShadowMask);
    if (LightBandCount > 0u)
    {
        const float MappingWeight = saturate(LightBandParams[SelectedLightBand].z);
        MappedBandColorWeight = LightBandParams[SelectedLightBand].w;
        MappedBandColor = max(LightBandColors[SelectedLightBand].rgb, 0.0f);
        if (bShadowColorVolumeValid != 0u)
        {
            MappedBandColor = lerp(MappedBandColor, max(VolumeColor.rgb, 0.0f), saturate(ShadowColorVolumeWeight) * MappingWeight);
        }
        MappedBandColor = lerp(MappedBandColor, max(ShadowTexel.rgb, 0.0f),
            saturate(ShadowTextureWeight) * saturate(ShadowTexel.a) * MappingWeight);
    }

	if (DebugView == 1)
	{
		OutColor = float4(Weight.xxx, 1.0f);
	}
	else if (DebugView == 2)
	{
		// [DeferredToon] Show the actual affected region.  Displaying the raw
		// curve color made a white curve look like a full-screen pass even when
		// the volume did not cover the pixel.
		OutColor = float4(AuthoredShadowColor * ToonBinaryShadowMask * Weight, 1.0f);
	}
	else if (DebugView == 3)
	{
		OutColor = float4(saturate(abs(Priority) / 16.0f).xxx, 1.0f);
	}
	else if (DebugView == 4)
	{
		OutColor = float4(saturate(DirectLightInput.rgb), 1.0f);
	}
	else if (DebugView == 5)
	{
		OutColor = float4(NativeShadowMask.xxx, 1.0f);
	}
	else if (DebugView == 6)
	{
		OutColor = float4(ShadowChannelMask.xxx, 1.0f);
	}
	else if (DebugView == 7)
	{
		OutColor = float4(saturate(BaseColorInput.rgb), 1.0f);
	}
	else if (DebugView == 8)
	{
		OutColor = float4(saturate(GBufferData.WorldNormal * 0.5f + 0.5f), 1.0f);
	}
	else if (DebugView == 9)
	{
		OutColor = float4(SceneTexturesStruct.ScreenSpaceAOTexture.SampleLevel(SceneTexturesStruct_ScreenSpaceAOTextureSampler, UV, 0).rrr, 1.0f);
	}
	else if (DebugView == 10)
	{
		OutColor = float4(StyleMask.xxx, 1.0f);
	}
	else if (DebugView == 11)
	{
		OutColor = float4(saturate(StyleColor), 1.0f);
	}
	else if (DebugView == 12)
	{
		// [DeferredToon] Display linear depth with a fixed 100 m reference range
		// so nearby geometry remains readable without changing the semantic value.
		OutColor = float4(saturate(GBufferData.Depth / 10000.0f).xxx, 1.0f);
	}
	else if (DebugView == 13)
	{
		// [DeferredToon] Motion vectors are signed; remap them around 0.5 so
		// forward/backward and left/right motion remain visible in the preview.
		const float3 EncodedVelocity = SceneTexturesStruct.GBufferVelocityTexture.SampleLevel(GlobalPointClampedSampler, UV, 0).rgb;
		OutColor = float4(saturate(EncodedVelocity * 0.5f + 0.5f), 1.0f);
	}
	else if (DebugView == 14)
	{
		// [DeferredToon] DirectLight illumination mask before style mapping.
		OutColor = float4(DirectLightMask.xxx, 1.0f);
	}
	else if (DebugView == 15)
	{
		// [DeferredToon] Native UE occlusion mask from ShadowBuffer.
		OutColor = float4(NativeShadowMask.xxx, 1.0f);
	}
	else if (DebugView == 16)
	{
		// [DeferredToon] Shadow Channel subtraction mask.
		OutColor = float4(ShadowChannelMask.xxx, 1.0f);
	}
	else if (DebugView == 17)
	{
		// [DeferredToon] Union of the native and channel shadow masks.
		OutColor = float4(CombinedShadowMask.xxx, 1.0f);
	}
	else if (DebugView == 18)
	{
		// [DeferredToon] Direct specular contribution is visible independently
		// so roughness/highlight energy cannot contaminate DirectLight debug.
		OutColor = float4(max(SpecularBufferTexture.SampleLevel(SpecularBufferSampler, UV, 0).rgb, 0.0f), 1.0f);
	}
	else if (DebugView == 19)
	{
		// [DeferredToon] Effective dark selection plus the explicit artistic subtraction.
		OutColor = float4(ToonShadowMask.xxx, 1.0f);
	}
	else if (DebugView == 20)
	{
		// [DeferredToon] Preview the exact binary selector used by mode 3.
		OutColor = float4(ToonBinaryShadowMask.xxx, 1.0f);
	}
	else if (DebugView == 21)
	{
		// [DeferredToon] Inspect the raw angular input independently of thresholding.
		OutColor = float4(DirectLightFacing.xxx, 1.0f);
	}
    else if (DebugView == 22)
    {
        OutColor = float4(EffectiveLight.rgb * PrimaryView.PreExposure, 1.0f);
    }
    else if (DebugView == 23)
    {
        // [DeferredToon] Compress the decoded scene-linear value, then re-encode for
        // the downstream tonemapper, so changing pre-exposure does not dim this view.
        OutColor = float4((EffectiveLight.a / (1.0f + EffectiveLight.a)).xxx * PrimaryView.PreExposure, 1.0f);
    }
    else if (DebugView == 24)
    {
        // [DeferredToon] Data level is discrete, display still passes through the tonemapper.
        OutColor = float4(SelectedLightBandValue.xxx * PrimaryView.PreExposure, 1.0f);
    }
	else
	{
		// [DeferredToon] Retain whole-scene tint as an explicit auxiliary policy.
		// Diffuse reconstruction no longer multiplies material BaseColor twice.
		float3 OutputColor = SceneColor.rgb;
		if (OutputMode != 2u && bEffectiveLightAvailable == 0u)
		{
			// Missing lighting data is not evidence of shadow. Preserve the scene.
			OutColor = SceneColor;
			return;
		}
		if (OutputMode == 0u)
		{
			const float LightingValue = dot(max(DirectLightInput.rgb, 0.0f), float3(0.2126f, 0.7152f, 0.0722f));
			const float4 LightingColor = SampleColorCurve(saturate(LightingValue), LightingColorSamples);
			const float3 MappedLighting = SceneColor.rgb * max(LightingColor.rgb, 0.0f);
			const float3 ShadowedLighting = MappedLighting * lerp(1.0f.xxx, AuthoredShadowColor, ToonBinaryShadowMask);
			OutputColor = lerp(SceneColor.rgb, ShadowedLighting, Weight);
		}
		else if (OutputMode == 2u)
		{
			OutputColor = lerp(SceneColor.rgb, StyleColor, Weight);
		}
		else if (OutputMode == 3u)
		{
			// [DeferredToon] Use the resolved discrete palette, independent of native
			// SceneColor or lighting energy. BaseColor is optional material detail.
			const float3 ToonBandColor = MappedBandColor;
			const float3 ToonSurfaceColor = ToonBandColor * lerp(1.0f.xxx, BaseColorInput.rgb, saturate(BaseColorWeight));
			// Match the pre-exposed HDR scene before downstream TAA/TSR/tonemap.
			// SceneColor contributes only where the authored box weight is < 1.
			OutputColor = lerp(SceneColor.rgb, ToonSurfaceColor * PrimaryView.PreExposure, Weight);
		}
        else if (OutputMode == 4u)
        {
            // [DeferredToon] Grade the native visible diffuse, or replace either band.
            // Residual lighting is retained explicitly, without multiplying BaseColor twice.
            const float3 BandTintedColor = EffectiveLight.rgb * MappedBandColor;
            const float3 BandReplacementColor = MappedBandColor * AuthoredBase;
            const float3 GradedDirect = lerp(BandTintedColor, BandReplacementColor, saturate(MappedBandColorWeight)) * PrimaryView.PreExposure;
            const float3 OriginalColor = Texture2DSampleLevel(OriginalSceneColorTexture, SceneColorSampler, UV, 0).rgb;
            const float3 Residual = max(OriginalColor - EffectiveLight.rgb * PrimaryView.PreExposure, 0.0f);
            OutputColor = lerp(SceneColor.rgb, GradedDirect + Residual * saturate(OtherLightingWeight), Weight);
        }
		OutColor = float4(OutputColor, SceneColor.a);
	}
}
